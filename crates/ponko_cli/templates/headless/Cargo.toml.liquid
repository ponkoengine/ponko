[package]
name = "{{project-name}}"
version = "0.1.0"
edition = "2024"

# What `ponko package` puts in the download players get
# (https://ponko.dev/guide/packaging.html).
[package.metadata.ponko]
name = "{{project-name}}"            # the name players see
# id = "com.example.my-game"         # a reverse-DNS id you own (the app id on macOS, iOS, Android)
# icon = "assets/icon.png"           # a square PNG, 512 or 1024 pixels
assets = ["assets"]                  # shipped next to the program

[dependencies]
# The engine without a window, GPU, sound or gamepads: simulations, servers
# and batch runs. https://ponko.dev/guide/headless.html
ponko = { version = "0.2.0-rc.1", default-features = false }
serde = { version = "1", features = ["derive"] }

# Fast debug builds: your code with light optimization, the engine and the
# other dependencies fully optimized. Simulations and tests run many times
# faster than a plain debug build, edit -> build stays quick, and your own
# code keeps full debug info.
[profile.dev]
opt-level = 1

[profile.dev.package."*"]
opt-level = 3
# Backtraces still name files and lines in the engine; full debug info for
# the optimized dependencies would make a clean build a fifth slower and
# the target folder gigabytes bigger.
debug = "line-tables-only"

# syn runs only while building, inside derive macros: optimizing it costs
# more time than it saves (release builds don't optimize it either).
[profile.dev.package.syn]
opt-level = 0
