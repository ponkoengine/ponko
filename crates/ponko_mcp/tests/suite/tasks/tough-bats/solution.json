   "args": {
    "entity": "$bat"
   }
  },
  {
   "call": "load_scene",
   "args": {
    "path": "levels/cave.json"
   }
  },
  {
   "call": "list_entities",
   "args": {
    "with": [
     "Bat"
    ]
   },
   "save": {
    "b1": "/entities/0/entity",
    "b2": "/entities/1/entity",
    "b3": "/entities/2/entity",
    "b4": "/entities/3/entity"
   }
  },
  {
   "call": "set_component",
   "args": {
    "entity": "$b1",
    "component": "Health",
    "value": {
     "current": 30
    }
   }
  },
  {
   "call": "set_component",
   "args": {
    "entity": "$b2",
    "component": "Health",
    "value": {
     "current": 30
    }
   }
  },
  {
   "call": "set_component",
   "args": {
    "entity": "$b3",
    "component": "Health",
    "value": {
     "current": 30
    }
   }
  },
  {
   "call": "set_component",
   "args": {
    "entity": "$b4",
    "component": "Health",
    "value": {
     "current": 30
    }
   }
  },
  {
   "call": "save_scene",
   "args": {
    "path": "levels/cave.json"
   }
  },
  {
   "call": "set_resource",
   "args": {
    "resource": "Spawning",
    "value": {
