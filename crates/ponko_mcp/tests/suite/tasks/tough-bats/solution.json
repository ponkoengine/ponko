   "each": {
    "call": "run_ticks",
    "args": {
     "ticks": 1
    }
   }
  },
  {
   "call": "spawn_prefab",
   "args": {
    "path": "prefabs/bat.json",
    "at": [
     0,
     0
    ]
   },
   "save": {
    "bat": "/entity"
   }
  },
  {
   "call": "set_component",
   "args": {
    "entity": "$bat",
    "component": "Health",
    "value": {
     "current": 30
    }
   }
  },
  {
