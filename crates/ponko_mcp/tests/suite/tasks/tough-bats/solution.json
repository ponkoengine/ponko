    }
   }
  },
  {
   "call": "watch",
   "args": {
    "ticks": 372,
    "every": 62,
    "count": [
     "Bat"
    ]
   }
  },
  {
   "call": "entity_stats",
   "args": {
    "fields": [
     "Health.current"
    ],
    "with": [
     "Bat"
    ]
   }
  }
 ]
