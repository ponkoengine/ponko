{
 "steps": [
  {
   "call": "world_summary"
  },
  {
   "call": "entity_stats",
   "args": {
    "fields": [
     "Health.current"
    ],
    "with": [
     "Bat"
    ]
   }
  },
  {
   "call": "get_resource",
   "args": {
    "resource": "Spawning"
   }
  },
  {
   "call": "watch",
   "args": {
    "ticks": 200,
    "every": 50,
    "count": [
     "Bat"
    ]
   }
  },
  {
   "call": "entity_stats",
   "args": {
    "fields": [
     "Health.current"
    ],
    "with": [
     "Bat"
    ]
   }
  },
  {
   "write": "assets/spawner.json",
   "text": "{\n  \"prefab\": \"prefabs/bat.json\",\n  \"every_secs\": 6.0,\n  \"max_bats\": 8,\n  \"health_scale\": 1.0\n}\n"
  },
  {
   "until": {
    "call": "get_resource",
    "args": {
     "resource": "Spawning"
    },
    "pointer": "/every_secs",
    "equals": 6.0
