{
  "web_smoke": {
    "example": "web_smoke",
    "asset": "crab.png",
    "assetSize": "32x32",
    "assetSource": "4x2",
    "min": { "group_ready": 1 },
    "engineGpu": true,
    "music": true
  },
  "web_smoke_3d": {
    "example": "web_smoke_3d",
    "features": ["3d"],
    "asset": "models/house.glb",
    "min": { "models_drawn": 1, "triangles": 100 },
    "engineGpu": true
  },
  "coin_dash": {
    "example": "coin_dash",
    "asset": "coin_dash/coin.png",
    "assetSize": "32x32",
    "presses": [
      "Enter=screen:Playing",
      "Escape=screen:Paused",
      "Q=screen:Title",
      "O=screen:Settings",
      "Escape=screen:Title"
    ],
    "afterReload": ["settings_at_start:Loaded", "storage:persistent"],
    "engineGpu": true
  },
  "web_editor_save": {
    "example": "web_editor_save",
    "features": ["editor"],
    "asset": "crab.png",
    "assetSize": "32x32",
    "min": { "read_back": 1, "listed": 2 },
    "reloads": [
      ["found:Saved", "kept:Loaded", "reverted:1", "shipped:Build"],
      ["found:Build", "kept:Loaded", "reverted:0", "shipped:Build"]
    ],
    "persist": {
      "granted": [
        ["persistent:Granted", "persist_asks:1"],
        ["persistent:Granted", "persist_asks:0"],
        ["persistent:Granted", "persist_asks:0"]
      ],
      "refused": [
        ["persistent:Refused", "persist_asks:1"],
        ["persistent:Refused", "persist_asks:0"],
        ["persistent:Refused", "persist_asks:0"]
      ]
    },
    "engineGpu": true
  },
  "web_editor_unloaded": {
    "example": "web_editor_unloaded",
    "features": ["editor", "3d"],
    "query": "?editor=smoke/unloaded/scene.json",
    "asset": "smoke/unloaded/posts.gltf",
    "min": { "failed": 1 },
    "editMode": true,
    "clicks": ["@retry=linked:1"],
    "engineGpu": true
  },
  "lights2d": {
    "example": "lights2d",
    "asset": "crab.png",
    "assetSize": "32x32",
    "min": { "lights": 7 },
    "engineGpu": true
  }
}
